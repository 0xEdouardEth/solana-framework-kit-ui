{
  "name": "solana-framework-kit-ui",
  "version": "0.1.0",
  "description": "The missing wallet UI for Solana Framework Kit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ci:types": "tsc --noEmit",
    "ci:test": "bun test",
    "ci:build": "vite build"
  },
  "peerDependencies": {
    "@solana/addresses": ">=5.0.0",
    "@solana/client": ">=1.0.0",
    "@solana/react-hooks": ">=1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/addresses": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/addresses": "^5.5.1",
    "@solana/client": "^1.0.0",
    "@solana/react-hooks": "^1.0.0",
    "@types/bun": "latest",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^4.0.0"
  },
  "keywords": [
    "solana",
    "wallet",
    "web3",
    "blockchain",
    "react",
    "ui",
    "framework-kit",
    "wallet-standard",
    "connect",
    "dapp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xEdouardEth/solana-framework-kit-ui",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/0xEdouardEth/solana-framework-kit-ui/issues"
  },
  "homepage": "https://github.com/0xEdouardEth/solana-framework-kit-ui#readme"
}
